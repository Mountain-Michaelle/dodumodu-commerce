{
  "name": "skincare-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:site": "tsx scripts/build-site.mjs && tsx scripts/build-admin-pages.mjs",
    "build:site:snapshots": "tsx scripts/build-site.mjs --snapshots && tsx scripts/build-admin-pages.mjs",
    "dev": "npm run build:site && tsx watch src/node.ts",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build:site && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx migrations/migrate.ts",
    "db:baseline": "tsx migrations/migrate.ts --baseline",
    "db:seed": "node scripts/seed.mjs",
    "createsuperuser": "tsx scripts/createsuperuser.ts",
    "db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db.ps1 status",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db.ps1 start",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db.ps1 stop",
    "db:init": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db.ps1 init",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" \"migrations/**/*.test.ts\"",
    "test:db": "tsx --import ./scripts/require-test-db.mjs --test --test-concurrency=1 \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:mfa": "tsx --import ./scripts/require-test-db.mjs --test --test-concurrency=1 src/auth/totp.test.ts src/auth/totp-backup.test.ts src/auth/totp-relogin.test.ts src/auth/recovery.test.ts src/auth/device-trust.test.ts src/auth/blocks-flow.test.ts src/auth/sessions3b.test.ts",
    "db:reset-test": "node scripts/reset-test-db.mjs --yes",
    "test:ui:browser": "node --test src/auth-ui/login.browser.spec.mjs",
    "test:ui": "node --test src/auth-ui/*.test.mjs",
    "check:config": "node scripts/check-config.mjs",
    "test:deploy": "tsx --test src/services/publishService.test.ts src/services/storefrontStatus.test.ts src/services/deployProgress.test.ts src/routes/ci.test.ts src/routes/productPage.test.ts src/external/githubDeployTrigger.test.ts scripts/build-site.test.ts && node --test build/*.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@neondatabase/serverless": "^0.10.1",
    "drizzle-orm": "^0.45.4",
    "hash-wasm": "^4.12.0",
    "hono": "^4.6.9",
    "libphonenumber-js": "^1.11.20",
    "pg": "^8.23.0",
    "qrcode-generator": "^2.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241004.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "wrangler": "^3.90.0"
  }
}
