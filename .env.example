# ---------------------------------------------------------------------------
# Local development values. Copy to .env at the repository root:
#     cp .env.example .env
# .env is never committed. Real environment variables always win over this file,
# so a one-off override still works: DATABASE_URL=... npm run db:migrate
#
# This one file serves BOTH packages:
#   - dodumodu_backend reads it at boot (src/node.ts, migrations/migrate.ts,
#     drizzle.config.ts) and serves the app from Node.
#   - dodumodu_site reads it at build time (build/bundle.mjs) to fill in the
#     public values below.
# Cloudflare production never reads this file: Workers take vars from
# wrangler.toml and secrets from `wrangler secret put`; Cloudflare Pages takes
# its values from the project's environment settings. The keys are the same.
# ---------------------------------------------------------------------------

# ── Frontend (build time) ─────────────────────────────────────────────────
# The canonical origin used in <link rel=canonical>, og:url, JSON-LD, sitemap
# and robots. No trailing slash. Production: https://yourdomain.com
SITE_URL=https://yoursite.com

# Where the storefront calls the API. Leave EMPTY when the site and the API are
# served from the same origin, which is what `npm run dev` does locally and
# what a Worker route on your own domain does in production. On split domains
# (Pages + a workers.dev subdomain) set it to the API origin, e.g.
# https://skincare-backend.<subdomain>.workers.dev
API_BASE=

# Where product/testimonial images are fetched from. Locally the dev server
# serves uploads out of MEDIA_DIR under this prefix. In production this is the
# R2 custom domain (optionally behind Cloudflare Image Transformations), e.g.
# https://media.yourdomain.com
IMAGE_DELIVERY_BASE=/media

# Turnstile widget key (public; the matching secret is below). Empty disables
# the widget for local development — the build then emits an empty sitekey and
# the form skips the challenge instead of loading a script that cannot solve.
# Production: from the Cloudflare dashboard, for your real domain(s).
TURNSTILE_SITE_KEY=

# Placeholder imagery for the hero and the static testimonials. Development
# only — replace the HTML <img> sources with real media before launch.
PLACEHOLDER_IMAGE_BASE=https://picsum.photos

# ── Backend runtime ────────────────────────────────────────────────────────
# Local: a PostgreSQL you run yourself. Production: the Neon connection
# string (Neon dashboard → Connection Details). Used identically by both.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dodumodu
PORT=8787
ENVIRONMENT=sandbox
# CORS allowlist — exact origins, comma separated. Never '*'.
ALLOWED_ORIGINS=http://localhost:8787
# OPay API root: the sandbox host below, or https://api.opaycheckout.com
OPAY_BASE_URL=https://sandboxapi.opaycheckout.com

# ── Secrets ────────────────────────────────────────────────────────────────
# Empty locally. Pay Now (OPay) needs real sandbox credentials before that
# payment method works; pay on delivery does not. Never commit real values.
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
OPAY_MERCHANT_ID=
OPAY_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=
RECONCILE_CRON_SECRET=

# ── Local runtime only (never set on Cloudflare) ──────────────────────────
# Directory standing in for the R2 bucket, served at /media/* by `npm run dev`.
MEDIA_DIR=.media
R2_BUCKET_NAME=skincare-media
RATE_LIMIT_API_PER_MINUTE=20
ANALYTICS_IP_HMAC_SECRET=
ANALYTICS_IP_HMAC_VERSION=1
ANALYTICS_WARMUP_ENABLED=false
RATE_LIMIT_ORDER_PER_PHONE_PER_HOUR=5
MAX_ORDER_QUANTITY=20
# Assignment Mode (fulfilment routing). "true" reveals the Assignment Mode
# toolbar switch, the "Assigned to" filter and the assign/unassign actions.
# Off by default; turn it on per-environment when staff routing is in use.
ASSIGNMENT_MODE_ENABLED=false

# ── Admin Auth v2 (local testing + live email/TOTP) ──────────────────────────
# ADMIN_AUTH_V2=1 turns on /auth/* + /admin-v2/* (off = those routes 404).
# OTP/THROTTLE/TOTP keys must each be 32 random bytes, standard base64:
#   openssl rand -base64 32   (run 3x, keep the 3 values DISTINCT)
# RESEND_API_KEY = live Resend key (https://resend.com/api-keys). With this set,
#   local `npm run dev` sends REAL emails via POST https://api.resend.com/emails
#   (from auth@example.com unless overridden) — check the real inbox.
# AUTH_FROM_EMAIL = the "from" sender for login codes. Must be a sender/domain
#   verified in your Resend account, or Resend rejects the send (403) and no
#   code arrives. Defaults to auth@example.com.
#   Example: AUTH_FROM_EMAIL=login@yourdomain.com
# ALLOW_TEST_IP=1 switches email to an in-memory capture mailbox (NO real send)
#   readable at GET /auth/test/mailbox/<email> — for automated tests only.
#   Keep it EMPTY for UI testing so you get live emails.
# TOTP_ENC_KEY encrypts authenticator secrets — use a REAL authenticator app
#   (Google Authenticator, 1Password, Authy, etc.) to scan the QR, no mock.
# ADMIN_AUTH_V2=0
# ALLOW_TEST_IP=
# OTP_KEY=
# THROTTLE_KEY=
# TOTP_ENC_KEY=
# RESEND_API_KEY=
# TURNSTILE_SECRET=
